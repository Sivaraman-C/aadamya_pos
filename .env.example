# Aadamya POS System - Environment Configuration
# Copy this file to .env and update values for your environment

# =====================================================
# APPLICATION SETTINGS
# =====================================================
CI_ENVIRONMENT=development
APP_NAME="Aadamya POS System"
APP_VERSION="1.0.0"
BASE_URL=http://localhost/aadamya_pos/

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_DRIVER=mysqli
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=your_secure_password
DB_DATABASE=aadamya_pos
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci
DB_DEBUG=true
DB_SAVE_QUERIES=true

# =====================================================
# DATABASE BACKUP
# =====================================================
DB_BACKUP_PATH=./backups/
DB_BACKUP_ENABLED=true

# =====================================================
# SECURITY SETTINGS
# =====================================================
ENCRYPTION_KEY=your_encryption_key_here
CSRF_PROTECTION=true
SESSION_SECURE=false

# =====================================================
# PAYMENT GATEWAY (Razorpay)
# =====================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =====================================================
# GOOGLE OAUTH (Optional)
# =====================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/aadamya_pos/auth/google_callback

# =====================================================
# TWILIO SMS SETTINGS (Optional)
# =====================================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# EMAIL SETTINGS (Optional)
# =====================================================
EMAIL_PROTOCOL=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@aadamya.com

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=debug
LOG_PATH=./application/logs/

# =====================================================
# FILE UPLOAD
# =====================================================
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,doc,docx
UPLOAD_PATH=./uploads/
